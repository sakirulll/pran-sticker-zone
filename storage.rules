rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isActiveMember(ownerId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(ownerId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.active == true;
    }
    function canAccessWorkspace(ownerId) {
      return request.auth != null
        && (request.auth.uid == ownerId || isActiveMember(ownerId));
    }

    match /workspaces/{ownerId}/products/{imageFile} {
      allow read, delete: if canAccessWorkspace(ownerId);
      allow create, update: if canAccessWorkspace(ownerId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
