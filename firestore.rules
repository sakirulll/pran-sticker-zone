rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveMember(ownerId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId}/private/{documentId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId)
        || (documentId == "pos" && isActiveMember(userId));
    }

    match /users/{userId}/private/{documentId}/products/{productId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || (documentId == "pos" && isActiveMember(userId)));
    }

    match /users/{ownerId}/members/{memberId} {
      allow read: if request.auth != null
        && (request.auth.uid == ownerId || request.auth.uid == memberId);
      allow create, update, delete: if request.auth != null && request.auth.uid == ownerId;
    }
    // Keep every other document private unless a separate rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
